# FleetGuard TMS — Environment Configuration
# Copy this file to .env and fill in your values

# --- Database ---
# SQLite (default, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./fleetguard.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://fleetguard:password@localhost:5432/fleetguard

# --- OCR / Document Intelligence ---
OCR_PROVIDER=mock
GOOGLE_DOCUMENT_AI_PROJECT_ID=""
GOOGLE_DOCUMENT_AI_LOCATION="us"
GOOGLE_DOCUMENT_AI_RECEIPT_PROCESSOR_ID=""
GOOGLE_DOCUMENT_AI_RECEIPT_LOCATION=""
GOOGLE_DOCUMENT_AI_ID_PROCESSOR_ID=""
GOOGLE_DOCUMENT_AI_ID_LOCATION=""
GOOGLE_DOCUMENT_AI_GENERIC_PROCESSOR_ID=""
GOOGLE_DOCUMENT_AI_GENERIC_LOCATION=""
GOOGLE_APPLICATION_CREDENTIALS=""

# --- OpenAI API (for legacy/other uses) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- WhatsApp Business API ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=fleetguard_webhook_verify_2026

# --- App Settings ---
DEBUG=true
SECRET_KEY=
CORS_ORIGINS=["http://localhost:5174","http://localhost:3000","http://127.0.0.1:5174"]

# --- CAPTCHA (Cloudflare Turnstile) ---
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- reCAPTCHA Enterprise ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_MIN_SCORE=0.4

# In local debug, keep true only if you want forgot-password token in API response.
PASSWORD_RESET_DEBUG_RETURN_TOKEN=true

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Supabase Storage ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=fleetguard-uploads

