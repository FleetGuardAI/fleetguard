# FleetGuard Frontend — Production Environment Configuration Example
# Used when building or deploying the Owner Web App for Production.
# In Vercel, configure this under Project Settings -> Environment Variables (Environment: Production)

# API Configuration — Points exclusively to the Production backend service
VITE_API_URL=https://fleetguard-hpip.onrender.com/api

# MSG91 Widget configuration (Production credentials)
VITE_MSG91_WIDGET_ID=366874697076393730333730
VITE_MSG91_WIDGET_TOKEN=<actual FleetGuardWeb token value>
