# FleetGuard Frontend — Staging Environment Configuration Example
# Used when building or deploying the Owner Web App for Staging/Preview.
# In Vercel, configure this under Project Settings -> Environment Variables (Environment: Preview)

# API Configuration — Points exclusively to the Staging backend service
VITE_API_URL=https://fleetguard-staging-api.onrender.com/api

# MSG91 Widget configuration (Staging test credentials)
VITE_MSG91_WIDGET_ID=366874697076393730333730
VITE_MSG91_WIDGET_TOKEN=staging_widget_token
