# Frontend Environment Configuration Example

# API Configuration
VITE_API_URL=https://fleetguard-hpip.onrender.com/api

# App Download Links (Android APKs & iOS App Store)
VITE_DRIVER_ANDROID_URL=
VITE_DRIVER_IOS_URL=
VITE_OWNER_ANDROID_URL=
VITE_OWNER_IOS_URL=

# App Versions (Optional)
VITE_DRIVER_ANDROID_VERSION=
VITE_DRIVER_IOS_VERSION=
VITE_OWNER_ANDROID_VERSION=
VITE_OWNER_IOS_VERSION=

# MSG91 Widget configuration (Client-side token, not the account AuthKey)
VITE_MSG91_WIDGET_ID=366874697076393730333730
VITE_MSG91_WIDGET_TOKEN=<actual FleetGuardWeb token value>
